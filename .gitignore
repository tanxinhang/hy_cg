# --- WorkBuddy 工作区内部数据（记忆等，绝不提交）---
.workbuddy/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# --- IDE ---
.idea/
*.iml
.vscode/

# --- 日志 ---
*.log

# --- LaTeX 编译产物 ---
*.aux
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
*.bbl
*.blg

# --- 实验中间产物（Code / CodeCg 的运行输出，非代码）---
Code/gate1_*/
Code/tracking_*/
Code/sweep_*/
Code/pred_*/
CodeCg/outputs_*/

# --- 小规模预览跑（MC=2 等冒烟数据，非论文结果）---
archive/results_preview_*/
/results_release_preview*/
/results_crn_check/
/results_crn_parallel_check/
/results_canonical_check/
/results_preview_capability/
/results_target_local_v1_smoke/
/.codex-*-smoke/
/results_target_local_v11*/
/results_v11_*/
/results_waveform_v2_phase1*/
/results_waveform_v2_gate1*/
/results_waveform_v2_gate2a*/
/results_waveform_v2_gate2b*/
/results_waveform_v2_gate3*/
/tmp/

# Editable figure masters are regenerated by the plotting scripts.
/Conference-LaTeX-template_10-17-19/figs/*_v1_*.svg
/Conference-LaTeX-template_10-17-19/figs/fig2_main_comparison.svg
/Conference-LaTeX-template_10-17-19/figs/fig2_main_comparison.png

# --- 旧模型/修正前本地备份（非源码，本地保留不入库）---
/archive/legacy_model_results/
/archive/paper_figs_pre_correction/
/archive/stale_single_nested_200mc/

# --- 离线传输包（git bundle 产物）---
*.bundle

# --- 图表 / PPT 构建中间产物（可由源脚本重生成）---
/.codex-*-build/
/.chart-data-*/
/ppt/.build_*/

# --- PPT 二进制（体积大且非论文源；ppt/ 下的 .py 脚本与 .md 母稿仍入库）---
/ppt/**/*.pptx

# --- 冒烟 / 预览跑（小 MC，非论文结果）---
/results_*_smoke/

# --- Active research run cache ---
# Canonical evidence promoted into studies/direction*/data is versioned there.
# The top-level results/ tree is a regenerable local run cache and may contain
# partial screens; do not mistake it for frozen evidence.
/results/

# --- 手工备份 / 改动前快照（本地保留，不入库）---
*.bak
*.bak-*
